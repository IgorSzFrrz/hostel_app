{
  "name": "hostel-app",
  "version": "0.0.0",
  "private": true,
  "description": "Inn / Bed & Breakfast / Hostel booking app — monorepo root.",
  "license": "UNLICENSED",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "bun run --filter './apps/*' dev",
    "build": "bun run --filter './packages/*' --filter './apps/*' build",
    "lint": "eslint .",
    "test": "bun run --filter @hostel/shared test && bunx vitest run --pool=threads apps/api/test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "bun run --filter './packages/*' --filter './apps/*' typecheck",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/node": "^22.5.0",
    "eslint": "^9.13.0",
    "globals": "^15.11.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.11.0",
    "vitest": "^2.1.9"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  }
}
