{
  "name": "@hostel/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "prebuild": "prisma generate --schema prisma/schema.prisma",
    "build": "tsup",
    "pretypecheck": "prisma generate --schema prisma/schema.prisma",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:validate": "prisma validate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:seed": "prisma db seed --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@fastify/sensible": "6.0.4",
    "@hostel/shared": "workspace:*",
    "@prisma/client": "5.22.0",
    "dotenv": "16.4.7",
    "fastify": "^5.8.5",
    "pino": "^9.4.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "prisma": "5.22.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
